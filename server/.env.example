# ================================================================
# ESTUDO-FOTO BOT — variáveis de ambiente
# Copie este arquivo pra .env e preencha. NUNCA commite o .env real.
# ================================================================

# --- ANTHROPIC ---------------------------------------------------
# Chave da Anthropic, criada em https://console.anthropic.com/settings/keys
# Carregue pelo menos US$ 5 de crédito.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo padrão. Haiku é mais barato; Sonnet é mais inteligente.
# claude-haiku-4-5-20251001  →  ~R$ 0.05 por estudo
# claude-sonnet-4-6          →  ~R$ 0.30 por estudo
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- META CLOUD API (WhatsApp Business) --------------------------
# Crie em https://developers.facebook.com → My Apps → WhatsApp
# Tutorial completo no README.md.

# Token permanente do system user (NÃO use o token temporário de 24h)
WHATSAPP_TOKEN=EAAG...

# Phone Number ID — aparece no dashboard "API Setup" da Meta
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Verify token — você inventa uma string secreta aqui e cola igual
# no painel da Meta quando configurar o webhook
WHATSAPP_VERIFY_TOKEN=invente-uma-string-secreta-aqui

# (Opcional) App Secret pra validar assinatura HMAC dos webhooks
# Boa prática de segurança. Pegue em: app → Settings → Basic → App Secret
WHATSAPP_APP_SECRET=

# --- SERVIDOR ----------------------------------------------------
PORT=3000
NODE_ENV=production

# --- BANCO DE DADOS ----------------------------------------------
# Caminho do arquivo SQLite. No Railway/Fly, aponte pra um volume
# persistente (ex: /data/bot.db). Em dev local, deixe local.
DB_PATH=./data/bot.db

# --- COTA GRÁTIS -------------------------------------------------
# Quantos estudos o usuário pode fazer sem pagar.
FREE_QUOTA=3

# --- TTS (opcional) ----------------------------------------------
# Se vazio, bot não envia áudio (só texto). Adicione depois quando
# tiver Google Cloud TTS configurado.
GOOGLE_APPLICATION_CREDENTIALS=

# --- ADMIN -------------------------------------------------------
# Número do admin (com DDI/DDD, sem +). Recebe alertas de erro
# e tem cota ilimitada pra testar.
ADMIN_PHONE=5511999999999
